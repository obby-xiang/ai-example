+    const older = buildMessage([{ kind: 'text', seg: 0, text: '旧回答', streaming: false }])
+    older.id = 'a-old'
+    const last = buildMessage([{ kind: 'text', seg: 0, text: '新回答', streaming: false }])
+    last.id = 'a-new'
+    store.messages = [older, last]
