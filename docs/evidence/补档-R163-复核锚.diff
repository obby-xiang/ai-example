+    await wrapper.find('[data-testid="edit-msg-u-edit"]').trigger('click')
+    expect(confirmSpy).toHaveBeenCalled()
+    expect((wrapper.find('textarea').element as HTMLTextAreaElement).value).toBe('草稿内容') // 未覆盖
