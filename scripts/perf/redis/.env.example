# AI session / Redis performance verification tool - environment template.
#
# Copy to your own shell profile or a private .env file. This file contains NO
# secret and NO machine-specific absolute path. All values are read from the
# process environment; export them before running `python -m perf_redis ...`.
#
# Exit codes: 0 ok, 1 runtime/verification failure, 2 config/safety/unknown,
# 3 selected scenario unsupported/blocked.

# ---------------------------------------------------------------------------
# Redis topology (the tool connects directly; the app connects independently)
# ---------------------------------------------------------------------------
REDIS_MODE=standalone
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# cluster mode: comma-separated seed nodes (host:port). Leave empty for standalone.
REDIS_CLUSTER_NODES=

# Optional ACL / TLS. Password is never printed or written to results.
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
# true only for self-signed test clusters; results record the boolean, not the cert.
REDIS_TLS_INSECURE=false

REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_CONNECT_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Application under test
# ---------------------------------------------------------------------------
APP_BASE_URL=http://127.0.0.1:8081
# Required only for the explicit session_activity cross-instance scenario.
# Must point to a different application instance sharing the same Redis topology.
APP_SECONDARY_BASE_URL=

# Must exist in TenantUserDirectory (default directory: 1/101, 1/102, 2/201, 2/202).
APP_TENANT_ID=1
APP_USER_ID=101
APP_TENANT_HEADER=X-Tenant-Id
APP_USER_HEADER=X-User-Id

# Fail fast when detecting structural slowness. Raise this explicitly for a
# endurance run. measure also caps each request to the remaining budget below.
APP_HTTP_TIMEOUT_SECONDS=30
APP_HTTP_VERIFY_TLS=true
PERF_USER_AGENT=ai-redis-perf/1.0

# Measurement budget (0 disables that limit). The first limit to expire stops the
# current scenario; later scenarios are marked skipped/budget_exhausted and all
# completed rows/stats are kept. A request's timeout is
# min(remaining budget, APP_HTTP_TIMEOUT_SECONDS), so one slow DELETE cannot
# keep blocking until the 30s ceiling after the budget is nearly gone.
PERF_MEASURE_SCENARIO_TIMEOUT_SECONDS=60
PERF_MEASURE_TOTAL_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------------------
# Safety gates (write operations refuse to run without these)
# ---------------------------------------------------------------------------
# Set true only on a dedicated, isolated Redis + app instance.
PERF_ISOLATED_ENV=false
# Remote Redis / cluster nodes require an explicit confirmation.
PERF_CONFIRM_REMOTE=false
# standalone db != 0 requires an explicit confirmation (cluster only supports db 0).
PERF_CONFIRM_NON_DEFAULT_DB=false
# Large scenarios (100k background, 2000 archives, 9000 frames, ...).
PERF_ALLOW_LARGE_SCALE=false
# 1,000,000 background keys (also needs PERF_ALLOW_LARGE_SCALE=true).
PERF_ALLOW_BACKGROUND_MILLION=false

# ---------------------------------------------------------------------------
# Namespace / run shape
# ---------------------------------------------------------------------------
# Leave empty to auto-create a unique namespace under PERF_OUTPUT_DIR/.namespace.
# Explicit value: letters/digits/_.-  length 2..41.
PERF_NAMESPACE=

PERF_PROFILE=smoke
# Comma-separated scenario ids; empty = all scenarios of PERF_PROFILE.
# Explicitly naming a blocked scenario fails instead of silently skipping it.
PERF_SCENARIOS=

PERF_REPEAT=2
PERF_WARMUP=1
# Applied to the first DELETE of every destructive scenario (same session).
PERF_CONCURRENCY=1

PERF_OUTPUT_DIR=./perf-redis-out
# Every generated key carries a bounded TTL (60..86400 seconds) so an interrupted
# run self-expires. Shared indexes gain/renew TTL without shortening a longer
# existing TTL or deleting foreign members; an existing TTL above 24h is rejected.
# Locks and leases keep shorter TTLs.
PERF_KEY_TTL_SECONDS=43200
PERF_BATCH_SIZE=500
PERF_SCAN_COUNT=1000

# Wait before verify (0 = immediate). The 60s memory re-verify runner may remove
# the durable pending ledger during a longer wait; verify accepts both states.
PERF_VERIFY_SETTLE_SECONDS=0
# Keep guard+pending while cleaning up (only if a real writer may still be alive).
PERF_KEEP_GUARD=false

# ---------------------------------------------------------------------------
# Optional faces
# ---------------------------------------------------------------------------
PERF_ENABLE_ATTACHMENTS=true
PERF_ENABLE_KB=true
PERF_ENABLE_KB_RELOAD=false
# File existence/deletion needs the app's absolute storage root.
PERF_APP_FILE_STORAGE_PATH=
PERF_ALLOW_FILE_DELETE=false

# Populate global ai:recovery:due with non-terminal synthetic runs. Default false:
# startup-resume scans that index and could drive a synthetic run with a real
# model. Leave false on shared app instances. Identity recovery/list indexes
# still mirror production and contain only this tool's run members.
PERF_WRITE_GLOBAL_RUN_INDEX=false

# ---------------------------------------------------------------------------
# Scenario sizes (override only when you know the cost)
# ---------------------------------------------------------------------------
PERF_BG_KEYS_ACTIVITY=3
PERF_BG_KEYS_10K=10000
PERF_BG_KEYS_100K=100000
PERF_BG_KEYS_1M=1000000
PERF_RUNS_SMALL=1
PERF_RUNS_MED=10
PERF_RUNS_LARGE=50
PERF_STAGING_SMALL=5
PERF_STAGING_LARGE=500
PERF_ARCHIVE_SMALL=10
PERF_ARCHIVE_LARGE=2000
PERF_FRAMES_SMALL=128
PERF_FRAMES_LARGE=9000
PERF_TRANSCRIPT_SMALL=100
PERF_TRANSCRIPT_LARGE=5000
PERF_MEMORY_SMALL=24
PERF_MEMORY_LARGE=400
PERF_ATTACHMENT_MAX=3
PERF_FEEDBACK_ROWS=2
