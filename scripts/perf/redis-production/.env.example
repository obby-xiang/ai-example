REDIS_MODE=standalone
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_CLUSTER_NODES=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_TLS_INSECURE=false
REDIS_COMMAND_TIMEOUT_MS=5000

PERF_ISOLATED_ENV=false
PERF_CONFIRM_REMOTE=false
PERF_CONFIRM_NON_DEFAULT_DB=false
PERF_NAMESPACE=
PERF_OUTPUT_DIR=./out-production
PERF_PROFILE=smoke
PERF_SCENARIOS=
PERF_BATCH_SIZE=500
PERF_KEY_TTL_SECONDS=43200
PERF_LEASE_TTL_MS=3000
PERF_ALLOW_LARGE_SCALE=false
PERF_ALLOW_BACKGROUND_MILLION=false

# startup_runner_active_scan_1m: smoke=2000, full=100000, stress=1000000.
# Explicit values above 100000 require both large-scale gates above.
PERF_STARTUP_BACKGROUND_KEYS=
# Optional external control keys only. The scenario never creates or deletes them.
# All self-created active/beat keys and host-index fields are always cleaned.
PERF_STARTUP_EXTERNAL_ACTIVE_KEY=
PERF_STARTUP_EXTERNAL_REMOTE_KEY=
PERF_STARTUP_EXTERNAL_INVALID_KEY=
PERF_MEMORY_MESSAGE_BYTES=16384
PERF_MEMORY_CONCURRENT_RUNS=4
PERF_LEASE_CONCURRENT_OWNERS=8
# Small KB sample only (65..256 docs, 64..2048 bytes/doc); no 10k-document generation.
PERF_KB_CORPUS_DOCS=130
PERF_KB_CORPUS_BODY_BYTES=256
PERF_TASK_EVENT_SATURATION_FRAMES=32
PERF_TASK_REDIS_DELAY_MS=80
# Default runs every required fault. Set false only for an explicitly reduced run,
# or select a comma-separated subset of the P0-P2 operations documented in README.md.
PERF_FAULT_INJECTION=true
PERF_FAULT_OPERATIONS=all
PERF_MVN_MODE=online
