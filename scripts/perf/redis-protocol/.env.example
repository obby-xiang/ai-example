# Redis candidate protocol harness (backend test sources) - environment template.
# No secret, no machine-specific absolute path. Export variables in the shell;
# the harness never reads .env automatically and never prints passwords.

# ---------------------------------------------------------------------------
# Build / dependency resolution (run.sh / run.cmd)
# ---------------------------------------------------------------------------
# online  = default; Maven may download missing dependencies, so a fresh device
#           works on the first run without editing any script.
# offline = pass -o and use the local repository only; keeps the repo's mvn -o
#           habit. Requires dependencies already present in ~/.m2.
PERF_MVN_MODE=online

# ---------------------------------------------------------------------------
# Topology: standalone or cluster. Business scripts/keys are identical.
# ---------------------------------------------------------------------------
REDIS_MODE=standalone
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# cluster: host:port,host:port,host:port ; leave empty for standalone
REDIS_CLUSTER_NODES=

REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_TLS_INSECURE=false
REDIS_COMMAND_TIMEOUT_MS=5000
REDIS_CONNECT_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Safety gates
# ---------------------------------------------------------------------------
# true only on a dedicated isolated Redis. Writes refuse to run otherwise.
PERF_ISOLATED_ENV=false
# remote Redis / any non-loopback cluster node needs this
PERF_CONFIRM_REMOTE=false
# standalone db != 0 needs this (cluster only supports db 0)
PERF_CONFIRM_NON_DEFAULT_DB=false
# 2000 archives / 10k background / 50 runs are "large"
PERF_ALLOW_LARGE_SCALE=false
# 100k background additionally needs this
PERF_ALLOW_BACKGROUND_100K=false
# use an already populated big keyspace instead of generating one (cluster)
PERF_EXISTING_BG_SCALE=0

# ---------------------------------------------------------------------------
# Namespace / output
# ---------------------------------------------------------------------------
# letters/digits/_.- length 2..41; empty = auto rp-YYYYMMDDHHmmss in output/.namespace
PERF_NAMESPACE=
# default is backend/target/redis-protocol-out (ignored by git)
PERF_OUTPUT_DIR=target/redis-protocol-out
PERF_PROFILE=smoke
# comma-separated scenario ids; empty = all scenarios of PERF_PROFILE
PERF_SCENARIOS=
PERF_REPEAT=2
PERF_WARMUP=1
# candidate default 500 (was 100); bounded pipeline, valid range 1..1000.
# Bigger batches only reduce round trips; they never relax gates or assertions.
PERF_BATCH_SIZE=500
# XRANGE keeps the exclusive pagination cursor in memory but sends the physical
# successor ID as an inclusive start, because Redis 5.0 rejects the 6.2+ "(id" form.
PERF_STREAM_PAGE_SIZE=256
PERF_STREAM_MAX_ENTRIES=10000
PERF_KEY_TTL_SECONDS=43200
# batch deletes renew the purge lease every TTL/3; do not inflate TTL to hide stalls
PERF_LEASE_TTL_MS=3000
PERF_FINALIZE=true

# ---------------------------------------------------------------------------
# Monotonic budgets (0 disables that budget)
# ---------------------------------------------------------------------------
PERF_SCENARIO_TIMEOUT_SECONDS=60
PERF_TOTAL_TIMEOUT_SECONDS=600

# ---------------------------------------------------------------------------
# Default gates (frozen before first run; override only with a reason)
# Never relax these to turn a RED Cluster run green.
# ---------------------------------------------------------------------------
PERF_GATE_EMPTY_P95_MS=250
PERF_GATE_RUNS50_P95_MS=2000
PERF_GATE_ARCHIVE2000_P95_MS=3000
PERF_GATE_MAX_SCAN_PAGES=0
PERF_GATE_MAX_BG_COMMAND_GROWTH=0

# identity used in key shapes (must be a valid positive tenant/user)
PERF_TENANT_ID=1
PERF_USER_ID=101
